DATABASE_URL=sqlite:///./fixhub.db
# production: postgresql+psycopg2://fixhub:${POSTGRES_PASSWORD}@db:5432/fixhub
# REDIS_URL: redis://localhost:6379/0 (compose uses redis://redis:6379/0)
# APP_ENV: development | production (production enforces secrets below)
APP_ENV=development
# API_TOKEN: required in production; frontend sends Authorization: Bearer <token>
API_TOKEN=
# GITHUB_WEBHOOK_SECRET: dev default; prod: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=dev-secret-change-me
# Provider selection: tokenrouter (default, free-tier friendly), openai,
# experiential/explabs, bynara, xkiro, or custom (all OpenAI-compatible).
# For experiential: LLM_PROVIDER=experiential, model slug from GET /v1/models
# (e.g. FIXHUB_MODEL=glm-5.3), key is xpl_... from settings/api-keys.
# For bynara: LLM_PROVIDER=bynara (key sk-nry-...). For xkiro: LLM_PROVIDER=xkiro (key sk-xt-...).
LLM_PROVIDER=tokenrouter
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_API_KEY=
BYNARA_BASE_URL=https://router.bynara.id/v1
BYNARA_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=
# Default model is a free-tier default. For interviews/demos prefer e.g. gpt-4o-mini.
# NOTE: the var name is FIXHUB_MODEL (NEXUS_MODEL works as a fallback alias).
# Model ids already carry the vendor prefix — write the full id, e.g.
# FIXHUB_MODEL=minimax/minimax-m3:free (NOT xkiro/minimax/...).
# Restart uvicorn after editing backend/.env — the running server keeps old values.
FIXHUB_MODEL=z-ai/glm-5.3-free
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_PER_MIN=20
# GitHub App (stay-connected mode). Key via env PEM or file path.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_SLUG=
# Stay-connected: any opened/reopened issue on a connected repo starts the
# agent immediately (costs LLM calls, capped by AGENT_MAX_COST_USD).
AUTO_TRIGGER_ON_ISSUE=true
# Automation (Claude-code style). AUTO_RUN=true starts the agent the moment a
# task is created (chat fix/instruction, Create button, webhook) — the UI polls
# the Agent Trace. Every run costs LLM calls; set false for manual Run clicks.
AUTO_RUN=true
# Hands-free PRs: verified runs (tests PASS + real diff + policy ALLOW +
# attached GitHub App) open a PR without an Approve click. Recorded as an
# AUTO_APPROVED approval row. Default-branch pushes stay DENY always.
AUTO_PR_ON_VERIFIED=false
# Agent skill injection (ECC/opencode pack). Empty = auto: vendored bundle
# (shipped in the image) first, then the local user pack, else silently off.
SKILLS_ENABLED=true
SKILLS_DIR=
SKILLS_TOP_K=2
SKILLS_MAX_CHARS=6000
# Agent auto-retry: total attempts = 1 + retries (default 3). Retries
# verification FAIL + retryable provider errors (429/5xx); 400/401/403 fail fast.
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_S=5
# Per-task spend guard (USD). 0 = unlimited (dev). Prod: e.g. 0.50.
AGENT_MAX_COST_USD=0
# Transcript budget per LLM call (chars). Older tool output shrinks first.
AGENT_CONTEXT_BUDGET_CHARS=60000
# Explore-subagent turns per task-tool call.
SUBAGENT_MAX_TURNS=6
# Queue backend: auto (redis when reachable, else memory). Prod: set REDIS_URL
# to ElastiCache. SQS adapter plugs into backend/app/queue.py same interface.
QUEUE_BACKEND=auto
