# Copy to backend/.env and fill in. Never commit real secrets.
ENV=dev
DATABASE_URL=sqlite:///./fixhub.db
# Postgres prod: postgresql+psycopg://user:pass@host:5432/fixhub
# (compose postgres service: postgresql+psycopg://fixhub:fixhub@postgres:5432/fixhub)
# Phase 4 production pool: total conns ~= (size+overflow) x (API instances + workers).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Phase 4 concurrency caps (0 = unlimited).
MAX_RUNNING_TASKS_GLOBAL=20
MAX_RUNNING_PER_USER=5
MAX_RUNNING_PER_REPO=2
# Phase 4 claim lease (must exceed JOB_TIMEOUT_S; recovery reaps expired leases).
TASK_LEASE_S=3600
# Final hardening coherence ladder (seconds, validated at startup):
#   LLM_TIMEOUT_S(120) < COMMAND_TIMEOUT_S(180) <= LLM_MAX_RUNTIME_S(900)
#     <= AGENT_BUDGET_S(2100) < JOB_TIMEOUT_S(2400) < TASK_LEASE_S(3600).
#   LEASE_RENEW_EVERY_S(120) << TASK_LEASE_S; TOOL_CLEANUP_GRACE_S(30) < renew.
#   TASK_LEASE_S must exceed provider+tool+renew+grace and must NOT be
#   arbitrarily huge (<= 2*JOB + 3600). See docs/TIMEOUTS.md.
LEASE_RENEW_EVERY_S=120
AGENT_BUDGET_S=2100
TOOL_CLEANUP_GRACE_S=30
# Dev-only relaxation for slow free-tier models. 0 = strict ladder everywhere.
# 1 = non-prod may boot with a scaled-but-ordered ladder (prod ignores it).
# Do NOT hand-edit 1500/1800 values; use this flag instead.
DEV_SLOW_MODEL=0
# Final hardening per-user LLM usage limits (conservative prod defaults).
MAX_LLM_REQUESTS_PER_TASK=40
MAX_TASKS_PER_USER_PER_DAY=20
MAX_INPUT_TOKENS_PER_TASK=0
MAX_OUTPUT_TOKENS_PER_TASK=0
# Phase 4.5 PG statement guard in ms (0 = off).
POSTGRES_STATEMENT_TIMEOUT_MS=30000
# Phase 4.5 login protection (attempts per window, lockout after).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_S=900
LOGIN_LOCKOUT_S=900
# Phase 4.5 admin bootstrap: comma-separated emails promoted idempotently.
ADMIN_EMAILS=
# Phase 4.5 auth cookie: production MUST set AUTH_COOKIE_SECURE=1 (fail-fast).
AUTH_COOKIE_SECURE=0

# Provider switch: "bynara" | "xkiro". Fill both keys once, flip one line after.
LLM_PROVIDER=bynara
BYNARA_BASE_URL=https://router.bynara.id/v1
BYNARA_API_KEY=
BYNARA_MODEL=nemotron-3.5-lightning-free
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=
XKIRO_MODEL=qwen/qwen3-coder-plus:free
# Legacy override: if LLM_API_KEY is set it wins over LLM_PROVIDER.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Agent budgets (coherent prod defaults; slow free-tier dev uses DEV_SLOW_MODEL=1).
LLM_TIMEOUT_S=120
COMMAND_TIMEOUT_S=180
LLM_MAX_ITERATIONS=40
LLM_MAX_RUNTIME_S=900
JOB_TIMEOUT_S=2400
# Opt-in live GitHub recovery test (disposable repo only, never prod data).
# Left empty by default; the test refuses to run without an explicit target.
# FIXHUB_TEST_REPO=owner/repository
# FIXHUB_TEST_INSTALLATION_ID=
# FIXHUB_TEST_TOKEN=

GITHUB_APP_ID=
# Prefer a mounted file over inline PEM. Inline multiline PEM breaks dotenv parsing.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=./fixhub-app.pem
GITHUB_WEBHOOK_SECRET=
# Docker Compose: /tmp/fixhub-workspaces (named volume in docker-compose.yml).
# Local Windows/macOS dev: ./workspaces
WORKSPACE_ROOT=/tmp/fixhub-workspaces
# Remove per-task workspaces after terminal states (1 = keep for debugging).
WORKSPACE_KEEP=0
# Queue (RQ/Redis). Compose sets redis://redis:6379/0; local dev uses localhost.
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=fixhub
# 1 = webhooks + /run enqueue to the worker. 0 = only create tasks / run inline.
AUTO_RUN_ON_WEBHOOK=1
# 1 = agent run commits+pushes+PRs immediately. 0 = stop at NEEDS_REVIEW for IDE approval.
AUTO_PUBLISH=1
# Phase 5 Firecracker microVM sandbox (Linux/KVM host only).
# host = legacy subprocess (dev/test only; production refuses to boot on it).
# firecracker = real microVMs via jailer (required in prod).
SANDBOX_BACKEND=host
FC_BINARY=/usr/local/bin/firecracker
JAILER_BINARY=/usr/local/bin/jailer
FC_KERNEL_IMAGE=/srv/firecracker/kernel/vmlinux
FC_ROOTFS_IMAGE=/srv/firecracker/rootfs/base.ext4
FC_CHROOT_BASE=/srv/firecracker/jails
FC_GUEST_VCPU=2
FC_GUEST_MEM_MIB=1024
FC_OVERLAY_MB=5120
FC_BOOT_TIMEOUT_S=30
FC_VSOCK_TIMEOUT_S=10
# Host-enforced egress allowlist (comma-separated suffixes; nft backstop + proxy).
FC_EGRESS_ALLOWLIST=api.github.com,codeload.github.com,objects.githubusercontent.com,pypi.org,files.pythonhosted.org,registry.npmjs.org
# Real-VM test gate: 1 = sandbox security tests REQUIRE real KVM microVMs and
# FAIL when prerequisites are missing (Linux CI). 0 = skip without KVM (laptop).
FC_REQUIRE_KVM=0
# Real-VM suite opt-in (Linux/KVM host): FIXHUB_FIRECRACKER_TEST=1 enables
# backend/tests/test_sandbox_firecracker.py (14 real-VM probes, no mocks).
# FIXHUB_FIRECRACKER_TEST=0
