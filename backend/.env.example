# Copy to backend/.env and fill in. Never commit real secrets.
ENV=dev
DATABASE_URL=sqlite:///./fixhub.db
# Postgres prod: postgresql+psycopg://user:pass@host:5432/fixhub

# Provider switch: "bynara" | "xkiro". Fill both keys once, flip one line after.
LLM_PROVIDER=bynara
BYNARA_BASE_URL=https://router.bynara.id/v1
BYNARA_API_KEY=
BYNARA_MODEL=nemotron-3.5-lightning-free
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=
XKIRO_MODEL=qwen/qwen3-coder-plus:free
# Legacy override: if LLM_API_KEY is set it wins over LLM_PROVIDER.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Agent budgets (raise for slow free-tier models).
LLM_MAX_ITERATIONS=40
LLM_MAX_RUNTIME_S=900
JOB_TIMEOUT_S=1200

GITHUB_APP_ID=
# Prefer a mounted file over inline PEM. Inline multiline PEM breaks dotenv parsing.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=./fixhub-app.pem
GITHUB_WEBHOOK_SECRET=
# Docker Compose: /tmp/fixhub-workspaces (named volume in docker-compose.yml).
# Local Windows/macOS dev: ./workspaces
WORKSPACE_ROOT=/tmp/fixhub-workspaces
# Remove per-task workspaces after terminal states (1 = keep for debugging).
WORKSPACE_KEEP=0
# Queue (RQ/Redis). Compose sets redis://redis:6379/0; local dev uses localhost.
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=fixhub
# 1 = webhooks + /run enqueue to the worker. 0 = only create tasks / run inline.
AUTO_RUN_ON_WEBHOOK=1
# 1 = agent run commits+pushes+PRs immediately. 0 = stop at NEEDS_REVIEW for IDE approval.
AUTO_PUBLISH=1
